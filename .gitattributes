# Normalize line endings so a Windows checkout cannot break shell scripts,
# workflow files or the byte-exact SHA-256 the docs site pins for its inline
# script.
* text=auto eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.woff2 binary
# The knowledge log only grows at its end, so two pull requests that each add an
# entry conflict there. Union keeps both; bin/knowledge-parity.mjs reports an
# entry that ends up out of date order.
knowledge/log.md merge=union
