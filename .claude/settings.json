{
  "enabledPlugins": {
    "context7@anthropic-plugin-directory": true,
    "skill-creator@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "claude-code-setup@anthropic-plugin-directory": true
  },
  "permissions": {
    "ask": [
      "Bash(bin/apply-repo-baseline.sh:* --apply*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-signoff.sh"
          }
        ]
      }
    ]
  }
}
