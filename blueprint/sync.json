{
  "flags": {
    "manifest": "the repository's docs.config.mjs sets a manifest, so docs-live also runs check-live.mjs --metadata"
  },
  "templates": {
    "claude": "managed",
    "commit-lint": "managed",
    "dco": "managed",
    "dependency-review": "managed",
    "docs": "managed",
    "docs-live": "managed",
    "environments": "managed",
    "gitleaks": "managed",
    "labeler": "managed",
    "release": "unmanaged",
    "reuse": "managed",
    "scancode": "managed",
    "scorecard": "managed",
    "verify": "unmanaged",
    "workflow-lint": "managed"
  },
  "starters": {
    "CODEOWNERS": {
      "mode": "managed",
      "paths": [
        ".github/CODEOWNERS",
        "CODEOWNERS",
        "docs/CODEOWNERS"
      ]
    },
    "editorconfig": {
      "mode": "managed",
      "paths": [
        ".editorconfig"
      ]
    },
    "gitattributes": {
      "mode": "managed",
      "paths": [
        ".gitattributes"
      ]
    },
    "gitleaks.toml": {
      "mode": "managed",
      "paths": [
        ".gitleaks.toml"
      ]
    },
    "guard-shared-checkout.mjs": {
      "mode": "managed",
      "paths": [
        ".claude/hooks/guard-shared-checkout.mjs"
      ]
    }
  },
  "repos": {
    "m3l-claude-mentor": {
      "flags": [
        "manifest"
      ],
      "paths": {
        "verify": ".github/workflows/ci.yml"
      }
    },
    "m3l-design": {
      "flags": []
    },
    "m3l-groundwork": {
      "flags": [
        "manifest"
      ],
      "paths": {
        "verify": ".github/workflows/ci.yml"
      }
    },
    "m3l-output-governor": {
      "flags": [
        "manifest"
      ]
    },
    "m3l-plugins": {
      "flags": [
        "manifest"
      ]
    },
    "m3l-prompt-optimizer": {
      "flags": [
        "manifest"
      ]
    }
  }
}
