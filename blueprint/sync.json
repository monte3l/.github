{
  "flags": {
    "manifest": "the repository's docs.config.mjs sets a manifest, so docs-live also runs check-live.mjs --metadata",
    "assets": "the repository's release builds a tarball and attaches it to the draft, so release.yml keeps its assets job"
  },
  "templates": {
    "claude": "managed",
    "commit-lint": "managed",
    "dco": "managed",
    "dependency-review": "managed",
    "docs": "managed",
    "docs-freshness": "managed",
    "docs-live": "managed",
    "environments": "managed",
    "gitleaks": "managed",
    "labeler": "managed",
    "release": "unmanaged",
    "reuse": "managed",
    "scancode": "managed",
    "scorecard": "managed",
    "verify": "unmanaged",
    "workflow-lint": "managed"
  },
  "starters": {
    "CODEOWNERS": {
      "mode": "managed",
      "paths": [
        ".github/CODEOWNERS",
        "CODEOWNERS",
        "docs/CODEOWNERS"
      ]
    },
    "editorconfig": {
      "mode": "managed",
      "paths": [
        ".editorconfig"
      ]
    },
    "gitattributes": {
      "mode": "managed",
      "paths": [
        ".gitattributes"
      ]
    },
    "gitleaks.toml": {
      "mode": "managed",
      "paths": [
        ".gitleaks.toml"
      ]
    },
    "guard-shared-checkout.mjs": {
      "mode": "managed",
      "paths": [
        ".claude/hooks/guard-shared-checkout.mjs"
      ]
    },
    "guard-secret-writes.mjs": {
      "mode": "managed",
      "paths": [
        ".claude/hooks/guard-secret-writes.mjs"
      ]
    },
    "guard-double-background.mjs": {
      "mode": "managed",
      "paths": [
        ".claude/hooks/guard-double-background.mjs"
      ]
    },
    "guard-shell-portability.mjs": {
      "mode": "managed",
      "paths": [
        ".claude/hooks/guard-shell-portability.mjs"
      ]
    },
    "guard-git-push-signed.mjs": {
      "mode": "managed",
      "paths": [
        ".claude/hooks/guard-git-push-signed.mjs"
      ],
      "requires": [
        "signed-range.mjs"
      ]
    },
    "signed-range.mjs": {
      "mode": "managed",
      "paths": [
        "bin/lib/signed-range.mjs",
        ".claude/hooks/lib/signed-range.mjs"
      ]
    },
    "require-signoff.sh": {
      "mode": "managed",
      "paths": [
        ".claude/hooks/require-signoff.sh"
      ]
    }
  },
  "repos": {
    "m3l-mentor": {
      "flags": [
        "manifest"
      ],
      "paths": {
        "verify": ".github/workflows/ci.yml"
      }
    },
    "m3l-design": {
      "flags": []
    },
    "m3l-groundwork": {
      "flags": [
        "manifest"
      ],
      "paths": {
        "verify": ".github/workflows/ci.yml"
      },
      "twins": {
        "guard-double-background.mjs": [
          "templates/core/.claude/hooks/guard-double-background.mjs"
        ],
        "guard-git-push-signed.mjs": [
          "templates/core/.claude/hooks/guard-git-push-signed.mjs"
        ],
        "guard-secret-writes.mjs": [
          "templates/core/.claude/hooks/guard-secret-writes.mjs"
        ],
        "guard-shell-portability.mjs": [
          "templates/packs/harness-extras/files/.claude/hooks/guard-shell-portability.mjs"
        ],
        "signed-range.mjs": [
          "templates/core/bin/lib/signed-range.mjs"
        ]
      }
    },
    "m3l-output-governor": {
      "flags": [
        "manifest"
      ]
    },
    "m3l-plugins": {
      "flags": [
        "manifest"
      ]
    },
    "m3l-prompt-optimizer": {
      "flags": [
        "manifest"
      ]
    }
  }
}
