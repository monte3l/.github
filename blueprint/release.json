{
  "workflow": "monte3l/.github/.github/workflows/release-prepare.yml",
  "finalize": [
    "monte3l/.github/.github/workflows/release-finalize.yml",
    "monte3l/.github/.github/workflows/release-publish.yml"
  ],
  "app": "monte3l-release",
  "secrets": [
    "RELEASE_APP_CLIENT_ID",
    "RELEASE_APP_PRIVATE_KEY"
  ],
  "appUsers": [
    ".github",
    "m3l-plugins"
  ],
  "exempt": {
    ".github": "not a software project with releases",
    "m3l-plugins": "a catalog: it pins other repositories' releases and publishes none"
  }
}
