{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "REPLACE-WITH-THE-COMMIT-OF-THE-LAST-RELEASE",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "REPLACE-WITH-PLUGIN-NAME",
      "component": "REPLACE-WITH-PLUGIN-NAME",
      "include-component-in-tag": true,
      "tag-separator": "--",
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
